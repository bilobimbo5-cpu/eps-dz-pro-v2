NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# مطلوب فقط لميزة "حذف الحساب نهائيًا" (/api/delete-account).
# احصل عليه من Supabase → Settings → API → "service_role" (السر، وليس anon).
# تحذير: هذا المفتاح يملك صلاحيات كاملة على قاعدة البيانات — لا تضف له بادئة
# NEXT_PUBLIC_ أبدًا، ولا تشاركه، ولا تضعه إلا في متغيرات بيئة الخادم (Vercel).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# المساعد الذكي (/ai-assistant) — مفتاح سري، يُستعمل فقط من app/api/ai-assistant/route.ts
# لا تضف بادئة NEXT_PUBLIC_ له حتى لا يُكشف في المتصفح
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5
